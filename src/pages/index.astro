---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="CoHealthNews | Clear, Simple Health News">
  <div class="hero">
    <h1>Health news you can actually understand</h1>
    <p>Straightforward articles on nutrition, wellness and the latest research, written for everyday readers.</p>
    <a class="button" href="#latest">Read the latest</a>
  </div>

  <section id="latest">
    <div class="container">
      <h2>Latest Articles</h2>
      {posts.length === 0 && <p>No articles yet. Publish your first one from /admin.</p>}
      <div class="cards">
        {posts.map((post) => (
          <div class="card">
            {post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}
            <div class="body">
              <span class="tag">{post.data.category}</span>
              <h3><a href={`/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about">
    <div class="container">
      <h2>About CoHealthNews</h2>
      <p>CoHealthNews covers health topics in plain language. Every article is meant to inform, and none of it replaces advice from a doctor or other qualified health professional.</p>
    </div>
  </section>
</Base>
